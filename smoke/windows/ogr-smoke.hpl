<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>ogr-windows-smoke</name>
    <name_sync_with_filename>N</name_sync_with_filename>
    <description>Windows end-to-end smoke for OGR Input through the shared Geometry Calculator runtime.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/13 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/13 00:00:00.000</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>OGR input</from>
      <to>Geometry Calculator</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Geometry Calculator</from>
      <to>Output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>OGR input</name>
    <type>OGR_INPUT_TRANSFORM</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fileName>__OGR_SMOKE_FILE__</fileName>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Geometry Calculator</name>
    <type>GEOMETRY_CALCULATOR_TRANSFORM</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <inputGeometryFieldName></inputGeometryFieldName>
    <operationId>GEOMETRY_TYPE</operationId>
    <outputFieldName>geometry_type</outputFieldName>
    <outputType>STRING</outputType>
    <errorMode>FAIL</errorMode>
    <attributes/>
    <GUI>
      <xloc>304</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Output</name>
    <type>Dummy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
    <GUI>
      <xloc>512</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
